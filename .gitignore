# Build output
node_modules/
dist/
storybook-static/
*.tsbuildinfo

# Internal working documents. These stay on disk and keep working locally —
# they are simply not part of the public repository.
CLAUDE.md
docs/

# Claude Design sync state. config.json MUST be committed: it pins each package
# to its Claude Design project, and losing it makes the next sync create a
# duplicate and orphan the original. Only the free-text notes stay private.
.design-sync/NOTES.md

# Editor and OS
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db
*.swp

# Secrets and local environment. Nothing here today; listed so nothing lands
# here by accident later.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.npmrc
.netrc

# Scratch. The restructure once left a stray .tmp-tokens.css in a commit;
# this is why.
*.tmp
*.tmp.*
.tmp-*
tmp/
*.log
npm-debug.log*
.eslintcache
coverage/

# design-sync working state. Per package, because this monorepo holds several
# design systems and each needs its own project pin. Only the durable set is
# committed: config.json, NOTES.md, conventions.md, previews/, overrides/.
**/.design-sync/sb-reference/
**/.design-sync/learnings/
**/.design-sync/.cache/
**/.design-sync/node_modules
**/.ds-sync/
**/ds-bundle/
