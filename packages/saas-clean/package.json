{
  "name": "@ds/saas-clean",
  "version": "0.1.0",
  "private": true,
  "description": "Modern SaaS: airy neutrals, one confident blue, soft corners.",
  "designSystem": {
    "title": "SaaS Clean",
    "tagline": "Airy, low-contrast neutrals with one confident blue. The register of a product that wants to look calm and well-run."
  },
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ds/shared": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
