{
  "name": "@ds/nocturne-cobalt",
  "version": "0.1.0",
  "private": true,
  "description": "Cold blue on black: the same system at midnight instead of by firelight.",
  "designSystem": {
    "title": "Nocturne Cobalt",
    "tagline": "Cold blue on black: the same system at midnight instead of by firelight.",
    "variantOf": "nocturne"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ds/shared": "*",
    "@ds/nocturne": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
