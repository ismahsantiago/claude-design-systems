{
  "name": "@ds/story-telling",
  "version": "0.1.0",
  "private": true,
  "description": "Editorial freight and operations journeys: from fragmented handoffs to visible outcomes.",
  "designSystem": {
    "title": "Story-Telling",
    "tagline": "Editorial freight and operations journeys: from fragmented handoffs to visible outcomes."
  },
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
    "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css",
    "./overrides.css": "./src/overrides.css"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ds/shared": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
